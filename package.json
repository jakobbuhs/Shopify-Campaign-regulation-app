{
    "name": "shopify-campaign-app",
    "version": "1.0.0",
    "scripts": {
        "dev": "ts-node-dev --respawn src/server.ts",
        "sync:catalog": "ts-node src/scripts/fullCatalogSync.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src test",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
        "migrate": "prisma migrate dev",
        "generate": "prisma generate",
        "postinstall": "prisma generate"
    },
    "dependencies": {
        "@prisma/client": "^5.0.0",
        "axios": "^1.4.0",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^4.18.2",
        "graphql-request": "^7.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.13.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "autoprefixer": "^10.4.21",
        "eslint": "^9.13.0",
        "eslint-config-prettier": "^9.1.0",
        "globals": "^15.11.0",
        "postcss": "^8.5.6",
        "prettier": "^3.3.3",
        "prisma": "^5.0.0",
        "tailwindcss": "^3.4.17",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.11.0",
        "vitest": "^2.1.9"
    }
}
