# ---------------------------------------------------------------------------
# Admin dashboard (Next.js) environment variables.
# Copy to .env.local and adjust. NEXT_PUBLIC_* values are exposed to the
# browser at build time, so never put secrets here.
# ---------------------------------------------------------------------------

# Base URL of the backend API. Some pages call the backend directly via
# `${NEXT_PUBLIC_API_URL}/...`; others call relative `/api/*` paths that rely
# on the Next.js rewrite in next.config.js. Note the wiring is currently
# inconsistent (see "Known limitations" in the README): the rewrite targets
# port 10000 and is not applied under `output: 'export'`. Point this at the
# origin where the backend is actually running.
NEXT_PUBLIC_API_URL="http://localhost:3000"
