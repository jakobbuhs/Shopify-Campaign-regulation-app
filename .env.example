# ---------------------------------------------------------------------------
# Backend environment variables (copy to .env and fill in real values).
# NEVER commit a real .env — it is gitignored. Use safe dummy values here.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (Neon in production).
DATABASE_URL="postgresql://user:password@localhost:5432/campaigns?schema=public"

# Shopify app credentials (from your Shopify Partner app).
SHOPIFY_API_KEY="your-shopify-api-key"
SHOPIFY_API_SECRET="your-shopify-api-secret"

# The shop this backend talks to, and its offline Admin API access token.
# SHOP_DOMAIN is the myshopify domain WITHOUT protocol.
# (Once the app is installed via /auth, tokens are also stored per-shop in the DB.)
SHOP_DOMAIN="your-store.myshopify.com"
SHOPIFY_ACCESS_TOKEN="shpat_your-offline-access-token"

# Public base URL of this backend (used for OAuth callback, webhook callback
# and CORS). No trailing slash.
APP_URL="https://your-app.example.com"

# Port the Express server listens on (defaults to 3000 if unset).
PORT="3000"
